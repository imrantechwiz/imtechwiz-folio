{
  "name": "imtechwiz-folio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "VITE_BASE=/imtechwiz-folio/ vite build --outDir dist-pages && cp dist-pages/index.html dist-pages/404.html && gh-pages -d dist-pages -m \"Deploy to GitHub Pages\""
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "gh-pages": "^6.2.0",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
